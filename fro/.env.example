# Base URL of your backend (Express server that serves SOS, shelter, team, weather data)
VITE_API_BASE_URL=http://localhost:5000/api

# Weather is now fetched through the backend's /api/weather endpoint
# (server.js -> weatherService.js), so no OpenWeather key or lat/lon
# is needed in the frontend anymore. Keep the key ONLY in the backend
# .env as WEATHER_API_KEY — never in a VITE_ variable, since anything
# prefixed VITE_ is bundled into the public JS and visible to anyone.

# Socket.IO server URL for live SOS/notification updates
VITE_SOCKET_URL=http://localhost:8000

# FastAPI endpoint that runs the YOLO/damage-detection model
VITE_AI_DAMAGE_ENDPOINT=http://localhost:8001/predict
